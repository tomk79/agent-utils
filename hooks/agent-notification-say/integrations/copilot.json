{
  "detect": { "configDir": "~/.copilot", "command": "copilot" },
  "link": { "dir": "~/.copilot/hooks-scripts" },
  "settings": {
    "file": "~/.copilot/hooks/agent-utils.json",
    "baseFields": { "version": 1 },
    "event": "permissionRequest",
    "entry": {
      "type": "command",
      "bash": "\"$HOME/.copilot/hooks-scripts/agent-notification-say.sh\" copilot"
    }
  }
}
