{
  "detect": { "configDir": "~/.cursor", "command": "cursor-agent" },
  "link": { "dir": "~/.cursor/hooks" },
  "settings": [
    {
      "file": "~/.cursor/hooks.json",
      "baseFields": { "version": 1 },
      "event": "beforeShellExecution",
      "entry": {
        "type": "command",
        "command": "\"$HOME/.cursor/hooks/agent-notification-say.sh\" cursor"
      }
    },
    {
      "file": "~/.cursor/hooks.json",
      "baseFields": { "version": 1 },
      "event": "beforeMCPExecution",
      "entry": {
        "type": "command",
        "command": "\"$HOME/.cursor/hooks/agent-notification-say.sh\" cursor"
      }
    }
  ]
}
